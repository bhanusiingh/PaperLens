# ============================================================
# PaperLens — .gitignore
# ============================================================

# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables and secrets
.env
.env.*
*.env
*.secret
*.key

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb

# Local PDFs (do not commit research papers or generated PDFs)
*.pdf

# Runtime data directories (preserve directory structures via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/sessions/*
!data/sessions/.gitkeep

# Sample data directory (preserve directory structure via .gitkeep; ignore large PDFs)
data/samples/*.pdf
!data/samples/.gitkeep

# Hugging Face model cache and weights
models/
checkpoints/
.cache/
*.bin
*.safetensors
*.h5
*.pt
*.pth
*.ckpt
*.onnx

# Evaluation outputs and generated benchmark results
results/*
!results/.gitkeep
!results/README.md

# Legacy Streamlit cache
.streamlit/

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs and temporary files
*.log
*.tmp
*.temp
tmp/
temp/

# Development agent skills and lockfiles
.agents/
skills-lock.json

# Design references and mockups
reference/
